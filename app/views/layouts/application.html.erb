<!DOCTYPE html>

<html>
  <%= render 'layouts/head' %>

  <body class="flex flex-col justify-between min-h-screen bg-bg text-body">
    <div>
      <%= render 'layouts/navbar' %>

      <%= render 'layouts/flashes' %>

      <% if logged_in? %>
        <div class="page-width flex flex-wrap gap-x-6">
          <% if browser.device.mobile? %>
            <button
              class="my-1 inline-flex items-center gap-1 min-h-[44px] text-primary-dark"
              data-controller="back-button"
              data-back-button-target="button"
              data-action="click->back-button#goBack"
            >
              <%= tabler_icon :'arrow-narrow-left' %><%= t('.back') %>
            </button>
          <% end %>

          <button
            id="pwa-install-button"
            type="button"
            class="my-1 min-h-[44px] text-primary-dark underline underline-offset-[3px] hidden"
          >
            <%= t('.install_app') %>
          </button>
        </div>
      <% end %>

      <% if content_for?(:title) %>
        <header class="bg-contrast">
          <div class="page-width pt-7 pb-5 md:pt-10 md:pb-7 flex flex-col gap-3">
            <h1 class="m-0"><%= content_for(:title) %></h1>
            <%= content_for(:header) %>
          </div>
        </header>
      <% end %>

      <main class="page-width pt-6 pb-16">
        <%= yield %>
      </main>
    </div>

    <%= render 'layouts/footer' %>
  </body>
</html>
