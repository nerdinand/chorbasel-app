<% member_links = []
admin_links = []

if logged_in?
  member_links = [[t('.dashboard'), dashboard_path]]

  if policy(:song_list).index?
    member_links << [t('.song_lists'), song_lists_path]
  end

  member_links << [t('.name_guessing'), new_name_guess_path]
  member_links << [t('.profiles'), profiles_path]

  if policy(:user).index?
    admin_links << [t('.users'), users_path]
  end

  if policy(:attendance).index?
    admin_links << [t('.attendances'), attendances_path]
  end

  if policy(:statistics).index?
    admin_links << [t('.statistics'), statistics_path]
  end

  if policy(:info).new?
    admin_links << [t('.infos'), infos_path]
  end
end

nav_link_classes = lambda do |path|
  state_classes = current_page?(path) ? 'border-primary-dark bg-contrast' : 'border-transparent hover:bg-contrast'
  "block px-4 py-3 border-l-4 text-ink no-underline hover:text-ink #{state_classes}"
end

bar_link_classes = lambda do |path|
  state_classes = current_page?(path) ? 'border-b-primary-dark text-ink font-medium' : 'border-b-transparent text-body hover:text-ink'
  "flex items-center px-3 whitespace-nowrap border-y-[3px] border-t-transparent no-underline #{state_classes}"
end %>

<div class="relative bg-bg border-b border-line" data-controller="visibility">
  <nav aria-label="Main" class="page-width pl-1 pr-3 md:px-10 min-h-14 xl:h-[68px] flex items-center xl:items-stretch gap-1 xl:gap-7">
    <% if logged_in? %>
      <button
        data-action="visibility#toggleTargets"
        type="button"
        class="size-11 flex-none flex items-center justify-center text-ink xl:hidden"
        aria-controls="main-menu"
        aria-expanded="false"
      >
        <span class="sr-only">Open main menu</span>

        <svg
          data-visibility-target="openIcon"
          class="size-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>

        <svg
          data-visibility-target="closeIcon"
          hidden
          class="size-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    <% end %>

    <%= link_to 'ChorBasel', root_path, class: 'self-center font-heading font-semibold text-lg text-ink no-underline hover:text-ink' %>

    <% if logged_in? %>
      <ul role="list" class="hidden xl:flex list-none p-0 m-0">
        <% member_links.each do |text, path| %>
          <li class="flex"><%= link_to text, path, class: bar_link_classes.call(path), aria: { current: current_page?(path) ? 'page' : nil } %></li>
        <% end %>

        <% if admin_links.any? %>
          <li class="my-5 mx-2 w-px bg-line" aria-hidden="true"></li>
        <% end %>

        <% admin_links.each do |text, path| %>
          <li class="flex"><%= link_to text, path, class: bar_link_classes.call(path), aria: { current: current_page?(path) ? 'page' : nil } %></li>
        <% end %>
      </ul>
    <% end %>

    <% if logged_in? %>
      <div class="ml-auto self-center md:flex-[0_1_340px] min-w-0">
        <%= render 'application/search_form' %>
      </div>

      <div data-controller="visibility" class="relative self-center ml-2">
        <button
          type="button"
          data-action="visibility#toggleTargets"
          class="size-11 flex-none flex items-center justify-center bg-primary-dark text-on-primary font-heading font-semibold text-sm"
          id="user-menu-button"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span class="sr-only">Open user menu</span>

          <% if current_user.face_picture.present? %>
            <%= image_tag current_user.face_picture.variant(:thumb), class: 'size-11 object-cover', alt: "Face picture" %>
          <% else %>
            <%= current_user.display_name.first %>
          <% end %>
        </button>

        <div
          data-visibility-target="hideable"
          hidden
          class="absolute right-0 z-10 mt-2 w-48 bg-bg py-1 border border-line shadow-lg"
          role="menu"
          aria-orientation="vertical"
          aria-labelledby="user-menu-button"
          tabindex="-1"
        >
          <%= link_to t('.my_data'), edit_user_path(current_user), class: 'block px-4 py-2 text-sm text-ink no-underline hover:bg-contrast hover:text-ink', role: 'menuitem', tabindex: '-1' %>
          <%= link_to t('.logout'), users_sign_out_path, method: :delete, class: 'block px-4 py-2 text-sm text-ink no-underline hover:bg-contrast hover:text-ink', role: 'menuitem', tabindex: '-1' %>
        </div>
      </div>
    <% else %>
      <%= link_to 'chorbasel.ch', t('external_links.website'), class: 'ml-auto self-center' %>
    <% end %>
  </nav>

  <% if logged_in? %>
    <div
      data-visibility-target="panel"
      hidden
      class="absolute inset-x-0 top-full z-20 bg-bg border-b border-line shadow-lg xl:hidden"
      id="main-menu"
    >
      <div class="py-2">
        <% member_links.each do |text, path| %>
          <%= link_to text, path, class: nav_link_classes.call(path) %>
        <% end %>

        <% if admin_links.any? %>
          <div class="my-2 border-t border-line"></div>
        <% end %>

        <% admin_links.each do |text, path| %>
          <%= link_to text, path, class: nav_link_classes.call(path) %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
