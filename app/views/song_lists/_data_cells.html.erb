<td><%= index + 1 %></td>

<td><%= song_list_item_icon(song_list_item) %></td>

<td>
  <b>
    <% if song_list_item.song? %>
      <%= link_to song_list_item.song do %>
        <%= song_list_item.display_name %>
      <% end %>
    <% else %>
      <%= song_list_item.display_name %>
    <% end %>
  </b>
  <p>
    <em><%= simple_format(song_list_item.notes) %></em>
  </p>
</td>
