<%= render 'errors', model: song %>

<%= form_for song do |f| %>
  <div class="form-field">
    <p>
      <%= f.label :title %>
      <%# i18n-tasks-use t('activerecord.attributes.song.title') %> *
    </p>

    <p><%= f.text_field :title %></p>
  </div>

  <div class="form-field">
    <p>
      <%= f.label :music_composer %>
      <%# i18n-tasks-use t('activerecord.attributes.song.music_composer') %>
    </p>

    <%= combobox(f, :music_composer, Song.all.pluck(:music_composer).compact.uniq, allow_custom_value: true) %>
  </div>

  <div class="form-field">
    <p>
      <%= f.label :texter %>
      <%# i18n-tasks-use t('activerecord.attributes.song.texter') %>
    </p>

    <%= combobox(f, :texter, Song.all.pluck(:texter).compact.uniq, allow_custom_value: true) %>
  </div>

  <div class="form-field">
    <p>
      <%= f.label :arranger %>
      <%# i18n-tasks-use t('activerecord.attributes.song.arranger') %>
    </p>

    <%= combobox(f, :arranger, Song.all.pluck(:arranger).compact.uniq, allow_custom_value: true) %>
  </div>

  <div class="form-field">
    <p>
      <%= f.label :key_signature %>
      <%# i18n-tasks-use t('activerecord.attributes.song.key_signature') %>
    </p>

    <%= combobox(f, :key_signature, Song.all.pluck(:key_signature).compact.uniq, allow_custom_value: true) %>
  </div>

  <div class="form-field">
    <p>
      <%= f.label :time_signature %>
      <%# i18n-tasks-use t('activerecord.attributes.song.time_signature') %>
    </p>

    <%= combobox(f, :time_signature, Song.all.pluck(:time_signature).compact.uniq, allow_custom_value: true) %>
  </div>

  <div class="form-field">
    <p>
      <%= f.label :language %>
      <%# i18n-tasks-use t('activerecord.attributes.song.language') %>
    </p>

    <%= combobox(f, :language, Song.all.pluck(:language).compact.uniq, allow_custom_value: true) %>
  </div>

  <div class="form-field">
    <p>
      <%= f.label :lyrics %>
      <%# i18n-tasks-use t('activerecord.attributes.song.lyrics') %>
    </p>

    <p><%= f.text_area :lyrics %></p>
  </div>

  <div class="form-field">
    <p>
      <%= f.label :repertoire %>
      <%# i18n-tasks-use t('activerecord.attributes.song.repertoire') %>
    </p>

    <p><%= f.check_box :repertoire %></p>
  </div>

  <div class="form-field">
    <p>
      <%= f.label :genres %>
      <%# i18n-tasks-use t('activerecord.attributes.song.genres') %>
    </p>

    <%= combobox(f, :genres, Song.all.pluck(:genres).flatten.uniq, multiselect: true, allow_custom_value: true) %>
  </div>

  <div class="form-field">
    <p>
      <%= f.label :registers %>
      <%# i18n-tasks-use t('activerecord.attributes.song.registers') %>
    </p>

    <p>
      <%= f.collection_check_boxes(:registers, Register::Song.all, :value, :human_name) do |box|
        content_tag :p, class: 'text-xs' do
          box.label { box.check_box + box.text }
        end
      end %>
    </p>
  </div>

  <p>
    <%= f.submit class: 'btn btn-primary' %>
    <%# i18n-tasks-use t('helpers.submit.song.create') %>
    <%# i18n-tasks-use t('helpers.submit.song.update') %>
  </p>
<% end %>
