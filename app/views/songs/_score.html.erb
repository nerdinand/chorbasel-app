<% if song.song_media.recording.any? %>
  <% score_url = url_for(song.score.file) if song.score&.file.present? %>
  <% metadata = song.score.metadata if song.score&.metadata.present? %>
  <%= content_tag :div, data: {controller: 'score', 'score-url-value': score_url, 'score-metadata-value': metadata, 'score-delay-in-milliseconds-value': 200} do %>
    <h2><%= t('.title') %></h2>

    <% song.song_media.recording.ordered_by_register.each do |recording| %>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 py-2.5 px-1 border-b border-line">
        <strong class="w-32 flex-none font-heading font-semibold text-[15px] text-ink">
          <% if recording.register.present? %>
            <%= human_register(recording.register) %>
          <% else %>
            <%= t('.all_registers') %>
          <% end %>
        </strong>

        <% if recording.file.present? %>
          <%= audio_tag url_for(recording.file), class: 'flex-[1_1_240px] min-w-0', controls: true, preload: 'none', data: {'score-target': 'audioTag', 'action': 'timeupdate->score#update'} %>
        <% else %>
          <%= audio_tag song_song_medium_load_path(song_id: recording.song.id, song_medium_id: recording.id), class: 'flex-[1_1_240px] min-w-0', controls: true, preload: 'none', data: {'score-target': 'audioTag', 'action': 'timeupdate->score#update'} %>
        <% end %>
      </div>
    <% end %>

    <%= content_tag :div, nil, class: "w-full overflow-x-auto score mt-6", data: {'score-target': 'score'} %>
  <% end %>
<% end %>
