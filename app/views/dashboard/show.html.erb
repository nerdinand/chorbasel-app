<div class="flex flex-col gap-2 [&>*]:my-0">
  <% if @info.present? %>
    <div class="<%= @info.kind %>">
      <p class="font-medium text-ink"><%= @info.title %></p>
      <%= @info.description %>
    </div>
  <% end %>

  <% unless current_user.profile_complete? %>
    <div class="alert flex flex-wrap items-center gap-x-3.5 gap-y-1">
      <p class="flex-[1_1_300px]"><%= t('.profile_completeness.message') %></p>
      <%= link_to t('.profile_completeness.link'), edit_user_path(current_user), class: 'font-medium' %>
    </div>
  <% end %>
</div>

<h2><%= t('.upcoming_birthdays.title') %></h2>

<p><%= t('.upcoming_birthdays.description') %></p>

<ul>
  <% @upcoming_birthdays.each do |user, next_birthday| %>
    <li>
      <%= l next_birthday %>: <b><%= user.full_name %></b>
    </li>
  <% end %>
</ul>

<h2><%= t('.calendar.title') %></h2>

<div class="table-scroll">
  <table class="table-wide">
    <thead>
      <tr>
        <% @overview_calendar_events.each do |calendar_event| %>
          <th class="<%= calendar_event_color_class(calendar_event) %>">
            <%= link_to_if policy(calendar_event).show?, calendar_event.date, calendar_event %>
          </th>
        <% end %>
      </tr>
    </thead>

    <tbody class="border-r-2">
      <tr>
        <% @overview_calendar_events.each do |calendar_event| %>
          <td class="text-center">
            <%= attendance_action_symbol(calendar_event) %>
          </td>
        <% end %>
      </tr>
    </tbody>
  </table>
</div>

<% if params[:load_past] != 'true' %>
  <div class="mt-10">
    <%= link_to t('.load_past'), {load_past: true} %>
  </div>
<% end %>

<% @calendar_events.each do |calendar_event| %>
  <div class="my-5 p-2 border-solid border-primary border-2 rounded bg-gray <%= calendar_event_color_class(calendar_event) %>">
    <p class="font-bold">
      <% if policy(Attendance).index? %>
        <%= link_to calendar_event do %>
          <%= calendar_event.summary %>
        <% end %>
      <% else %>
        <%= calendar_event.summary %>
      <% end %>
    </p>

    <%= render calendar_event %>

    <%= render 'attendance_status_and_action', attendance_check: @attendance_checks[calendar_event] %>
  </div>
<% end %>

<% if policy(:calendar_sync).create? %>
  <%= button_to t('.calendar_events.sync'), calendar_events_syncs_path, method: :post, class: 'btn btn-primary' %>
<% end %>
