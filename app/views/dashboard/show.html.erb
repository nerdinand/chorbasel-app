<% content_for(:title, t('.title')) %>

<% content_for(:header) do %>
  <p class="text-ink"><%= l(Date.current, format: '%A, %-d. %B') %></p>

  <div class="mt-3 flex items-start gap-1.5 overflow-x-auto [&_.status-square]:size-6">
    <% @overview_calendar_events.group_by { |e| e.starts_at.beginning_of_month }.each do |month, calendar_events| %>
      <% calendar_events.each_with_index do |calendar_event, index| %>
        <% special = !calendar_event.regular_practice? %>

        <div class="w-8 flex-none flex flex-col items-center gap-1 text-[13px] <%= calendar_event.today? ? 'font-semibold text-primary-dark' : 'font-medium' %>">
          <span class="flex"><%= attendance_action_symbol(calendar_event) %></span>

          <%# Special events get the same dark chip as the category badge in the timeline %>
          <span class="<%= 'px-1 bg-primary-dark text-on-primary' if special %>">
            <%= link_to_if policy(calendar_event).show?, calendar_event.starts_at.day, calendar_event, class: "no-underline #{'text-on-primary hover:text-on-primary' if special}" %>
          </span>
          <span class="min-h-4 text-xs whitespace-nowrap">
            <%= calendar_event.today? ? t('.today') : (l(month, format: '%b') if index.zero?) %>
          </span>
        </div>
      <% end %>
    <% end %>
  </div>

  <ul role="list" class="list-none p-0 m-0 flex flex-wrap gap-x-3.5 gap-y-1.5 text-[13px]">
    <%= render 'attendances/status_legend_items' %>
    <li class="flex items-center">
      <span class="px-1.5 bg-primary-dark text-on-primary font-medium"><%= t('.special_event') %></span>
    </li>
  </ul>
<% end %>

<% content_for(:notices) do %>
  <% if @info.present? %>
    <div class="<%= @info.kind %>">
      <p class="font-medium text-ink"><%= @info.title %></p>
      <%= @info.description %>
    </div>
  <% end %>

  <% unless current_user.profile_complete? %>
    <div class="alert flex flex-wrap items-center gap-x-3.5 gap-y-1">
      <p class="flex-[1_1_300px]"><%= t('.profile_completeness.message') %></p>
      <%= link_to t('.profile_completeness.link'), edit_user_path(current_user), class: 'font-medium' %>
    </div>
  <% end %>
<% end %>

<% @timeline_months.each do |timeline_month| %>
  <section aria-label="<%= l(timeline_month.month, format: '%B %Y') %>">
    <h2 class="sticky top-0 z-10 bg-bg mt-0 mb-0 pt-7 flex flex-wrap items-baseline justify-between gap-x-3">
      <%= l(timeline_month.month, format: '%B %Y') %>
      <span class="font-body text-sm font-normal text-muted"><%= month_counts(timeline_month) %></span>
    </h2>

    <% timeline_month.rows.each do |item, show_date| %>
      <% if item.is_a?(DashboardTimeline::Birthdays) %>
        <%= render 'birthdays_row', birthdays: item, show_date: %>
        <% next %>
      <% end %>

      <% calendar_event = item %>
      <% highlighted = calendar_event.today? || !calendar_event.regular_practice? %>

      <article class="flex flex-wrap items-start gap-x-5 gap-y-3 pr-4 <%= highlighted ? 'mt-3 mb-1 py-4 pl-1 bg-contrast' : 'py-4 px-1 border-b border-line' %>">
        <div class="w-[52px] flex-none flex flex-col items-center">
          <% if show_date %>
            <span class="text-[13px] font-medium <%= highlighted ? 'text-primary-dark' : 'text-muted' %>"><%= l(calendar_event.starts_at, format: '%a') %></span>
            <span class="font-heading font-semibold text-[22px] leading-tight <%= highlighted ? 'text-primary-dark' : 'text-ink' %>"><%= calendar_event.starts_at.day %></span>
          <% end %>
        </div>

        <div class="flex-[1_1_240px] min-w-0 text-[15px] text-muted">
          <% unless calendar_event.regular_practice? %>
            <%# i18n-tasks-use t('dashboard.show.category') %>
            <span class="inline-block mb-1 px-2 py-0.5 bg-primary-dark text-on-primary font-heading font-semibold text-xs"><%= t(".category.#{calendar_event.category}") %></span>
          <% end %>

          <h3 class="m-0">
            <%= link_to_if policy(Attendance).index?, calendar_event.summary, calendar_event %>
          </h3>

          <%= render calendar_event, with_date: false %>
        </div>

        <div class="max-w-full">
          <%= render 'attendance_status_and_action', attendance_check: @attendance_checks[calendar_event] %>
        </div>
      </article>
    <% end %>
  </section>
<% end %>

<% if @past_calendar_events.any? %>
  <section aria-labelledby="dashboard-past">
    <h2 id="dashboard-past" class="mt-0 mb-0 pt-9 flex flex-wrap items-baseline justify-between gap-x-3">
      <%= t('.past.title') %>
      <span class="font-body text-sm font-normal text-muted"><%= t('.past.description', count: @past_calendar_events.size) %></span>
    </h2>

    <% @past_calendar_events.each do |calendar_event| %>
      <% status = @attendance_checks[calendar_event].attendance.status %>

      <article class="flex flex-wrap items-center gap-x-5 gap-y-1 py-3 px-1 border-b border-line">
        <span class="w-24 flex-none text-sm font-medium text-muted"><%= l(calendar_event.starts_at, format: '%a, %-d. %b') %></span>
        <span class="flex-[1_1_200px] min-w-0"><%= link_to_if policy(Attendance).index?, calendar_event.summary, calendar_event %></span>
        <span class="flex items-center gap-2 text-[15px] font-medium">
          <%= icon_for_status(status) %>
          <%= t("activerecord.attributes.attendance.enums.status.#{status}") %>
        </span>
      </article>
    <% end %>
  </section>
<% end %>

<% if policy(:calendar_sync).create? %>
  <div class="mt-10">
    <%= button_to t('.calendar_events.sync'), calendar_events_syncs_path, method: :post, class: 'btn btn-secondary' %>
  </div>
<% end %>
