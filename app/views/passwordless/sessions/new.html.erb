<% content_for :title, t('.title') %>
<% content_for :header do %>
  <p class="max-w-[520px] text-[17px] leading-normal"><%= t('.intro') %></p>
<% end %>

<div class="max-w-[440px] pt-4">
  <%= form_with(model: @session, url: url_for(action: 'new'), data: { turbo: 'false' }, class: 'flex flex-col gap-2.5') do |f| %>
    <% email_field_name = :"passwordless[#{email_field}]" %> <%# herb:disable actionview-no-silent-helper %>

    <%= f.label email_field_name,
        t("passwordless.sessions.new.email.label"),
        for: "passwordless_#{email_field}" %>

    <%= email_field_tag email_field_name,
        params.fetch(email_field_name, nil),
        required: true,
        autofocus: true,
        autocomplete: 'email',
        placeholder: t("passwordless.sessions.new.email.placeholder"),
        aria: { describedby: 'email-hint' } %>

    <p id="email-hint" class="text-sm text-muted"><%= t('.email.hint') %></p>

    <%= f.submit t("passwordless.sessions.new.submit"), class: 'btn btn-primary mt-2.5' %>
  <% end %>

  <div class="mt-9 pt-4 border-t border-line flex flex-col gap-2">
    <p><%= t('.trouble') %> <%= link_to t('.user_manual'), t('external_links.user_manual'), target: '_blank' %></p>
    <p><%= t('.not_a_member') %> <%= link_to t('.website'), t('external_links.website'), target: '_blank' %></p>
  </div>
</div>
