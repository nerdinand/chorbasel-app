<%= render 'errors', model: score %>

<%= form_for score, url: song_score_path(score.song, score) do |f| %>
  <%= f.hidden_field :song_id %>

  <div class="form-field">
    <p>
      <%= f.label :file %> <%# i18n-tasks-use t('activerecord.attributes.score.file') %>
    </p>

    <p><%= f.file_field :file, accept: 'application/vnd.mei+xml' %></p>
  </div>

  <div class="form-field">
    <p>
      <%= f.label :segment_markers %> <%# i18n-tasks-use t('activerecord.attributes.score.segment_markers') %>
    </p>

    <p><%= f.textarea :segment_markers %></p>
  </div>

  <div class="form-field">
    <p>
      <%= f.label :measure_markers %> <%# i18n-tasks-use t('activerecord.attributes.score.measure_markers') %>
    </p>

    <p><%= f.textarea :measure_markers %></p>
  </div>

  <p>
    <%= f.submit class: 'btn btn-primary' %> <%# i18n-tasks-use t('helpers.submit.score.create') %>
  </p>
<% end %>
