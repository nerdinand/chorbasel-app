<% user_status = attendance_table.user_status_for(user, calendar_event) %>

<% if user_status.try(:active?) %>
  <% attendance = attendance_table.attendance_for(user, calendar_event) %>
  <% if attendance.nil? %>
    <%= link_to icon_for_status(Attendance::STATUS_UNKNOWN), new_attendance_path(user_id: user, calendar_event_id: calendar_event), class: 'flex justify-center' %>
  <% else %>
    <%= link_to icon_for_status(attendance.status), edit_attendance_path(attendance), class: 'flex justify-center' %>
  <% end %>
<% else %>
  <%= icon_for_user_status(user_status.try(:status)) %>
<% end %>
