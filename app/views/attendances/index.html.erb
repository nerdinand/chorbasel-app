<% content_for :title, t('.title') %>

<% if @excuse_requested_attendances.any? %>
  <div class="alert">
    <p class="font-medium text-ink"><%= t('.excuse_requested.title') %></p>
    <ul role="list" class="list-none p-0 mt-2 mb-0 flex flex-col gap-1">
      <% @excuse_requested_attendances.each do |attendance| %>
        <li>
          <%= link_to edit_attendance_path(attendance) do %>
            <%= render attendance %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="mt-6 flex justify-end gap-2">
  <%= link_to @attendance_pagination.previous_params, class: 'size-11 flex items-center justify-center border border-primary text-primary-dark no-underline' do %>
    <span class="sr-only"><%= t('.previous') %></span>
    <%= tabler_icon 'arrow_left', classes: ['size-5'] %>
  <% end %>

  <%= link_to @attendance_pagination.next_params, class: 'size-11 flex items-center justify-center border border-primary text-primary-dark no-underline' do %>
    <span class="sr-only"><%= t('.next') %></span>
    <%= tabler_icon 'arrow_right', classes: ['size-5'] %>
  <% end %>
</div>

<div class="md:hidden">
  <%= render 'stacked_table', attendance_table: @attendance_table %>
</div>

<div class="hidden md:block">
  <%= render 'table', attendance_table: @attendance_table %>
</div>
