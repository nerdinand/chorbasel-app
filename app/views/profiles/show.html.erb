<%= turbo_frame_tag @user do %>
  <%= image_tag @user.profile_picture.variant(:medium), class: "w-full h-full object-cover object-bottom", alt: "Profile picture" %>

  <div class="flex flex-col gap-2 mt-2">
    <% if @user.register.present? %>
      <%# Solid background, since the badge sits on the photo %>
      <p class="absolute top-2 left-2 bg-bg text-ink font-semibold text-sm px-2 py-1 flex items-center gap-2">
        <span class="size-2.5" style="background: <%= AttendanceTallyTable::COLORS[@user.canonical_register] %>"></span>
        <span><%= human_register(@user.register) %></span>
      </p>
    <% end %>

    <p class="font-semibold text-lg leading-tight"><%= @user.full_name %></p>
  </div>
<% end %>
